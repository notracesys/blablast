
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados da conta do usuário, saldo financeiro e estatísticas de jogo",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Nome completo do usuário"
        },
        "phone": {
          "type": "string",
          "description": "Telefone de contato"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email para login"
        },
        "balance": {
          "type": "number",
          "description": "Saldo atual em conta"
        },
        "gamesPlayed": {
          "type": "number",
          "description": "Total de partidas iniciadas"
        },
        "totalRedeems": {
          "type": "number",
          "description": "Quantidade total de resgates realizados"
        },
        "totalWinnings": {
          "type": "number",
          "description": "Soma total de todos os prêmios ganhos"
        },
        "maxRedeem": {
          "type": "number",
          "description": "O maior prêmio individual já resgatado"
        },
        "referredBy": {
          "type": "string",
          "description": "UID do usuário que indicou este perfil"
        },
        "commissionBalance": {
          "type": "number",
          "description": "Saldo disponível de comissões de afiliados"
        },
        "totalCommissionEarned": {
          "type": "number",
          "description": "Total histórico ganho com indicações"
        },
        "referredCount": {
          "type": "number",
          "description": "Quantidade de pessoas que se cadastraram pelo link"
        },
        "referredDepositVolume": {
          "type": "number",
          "description": "Volume total depositado pelos indicados"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação da conta"
        }
      },
      "required": [
        "fullName",
        "phone",
        "email",
        "balance"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Informações de perfil do usuário indexadas pelo UID"
    }
  }
}
