
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados da conta do usuário e saldo financeiro",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Nome completo do usuário"
        },
        "phone": {
          "type": "string",
          "description": "Telefone de contato"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email para login"
        },
        "balance": {
          "type": "number",
          "description": "Saldo atual em conta"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Data de criação da conta"
        }
      },
      "required": [
        "fullName",
        "phone",
        "email",
        "balance"
      ]
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Informações de perfil do usuário indexadas pelo UID"
    }
  }
}
