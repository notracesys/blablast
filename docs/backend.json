
{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Dados da conta do usuário, saldo financeiro e estatísticas de jogo",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "balance": { "type": "number" },
        "gamesPlayed": { "type": "number" },
        "totalRedeems": { "type": "number" },
        "totalWinnings": { "type": "number" },
        "maxRedeem": { "type": "number" },
        "referredBy": { "type": "string" },
        "referralCode": { "type": "string" },
        "commissionBalance": { "type": "number" },
        "totalCommissionEarned": { "type": "number" },
        "referredCount": { "type": "number" },
        "referredDepositVolume": { "type": "number" },
        "isAdmin": { "type": "boolean", "default": false },
        "status": { "type": "string", "enum": ["active", "blocked", "suspended"] },
        "lastActivity": { "type": "string", "format": "date-time" },
        "deviceInfo": { "type": "string" },
        "ipAddress": { "type": "string" },
        "fraudFlags": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fullName", "phone", "email", "balance"]
    },
    "GlobalSettings": {
      "title": "GlobalSettings",
      "description": "Configurações globais da plataforma",
      "type": "object",
      "properties": {
        "difficulty": { "type": "number", "description": "0 a 100 (0=Fácil, 100=Impossível)" },
        "totalDeposited": { "type": "number" },
        "gridSize": { "type": "number", "default": 8 },
        "maxLinesPerMatch": { "type": "number", "default": 5 },
        "antiFraudEnabled": { "type": "boolean", "default": true }
      }
    },
    "MatchRecord": {
      "title": "MatchRecord",
      "description": "Histórico detalhado de cada partida jogada",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "duration": { "type": "number" },
        "entryFee": { "type": "number" },
        "result": { "type": "number" },
        "linesCompleted": { "type": "number" },
        "piecesGenerated": { "type": "array", "items": { "type": "object" } },
        "movements": { "type": "array", "items": { "type": "object" } },
        "fraudDetected": { "type": "boolean" }
      }
    },
    "InfluencerProfile": {
      "title": "InfluencerProfile",
      "description": "Dados de desempenho de influenciadores",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "code": { "type": "string" },
        "clicks": { "type": "number" },
        "registrations": { "type": "number" },
        "activeUsers": { "type": "number" },
        "commissionRate": { "type": "number" },
        "status": { "type": "boolean" }
      }
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Registro de ações administrativas",
      "type": "object",
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "actorId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "oldValue": { "type": "any" },
        "newValue": { "type": "any" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Informações de perfil do usuário"
    },
    "settings/game": {
      "schema": "GlobalSettings",
      "description": "Controle de dificuldade e métricas globais"
    },
    "matches/{matchId}": {
      "schema": "MatchRecord",
      "description": "Registros de partidas"
    },
    "influencers/{influencerId}": {
      "schema": "InfluencerProfile",
      "description": "Dados de afiliados e influenciadores"
    },
    "logs/{logId}": {
      "schema": "AuditLog",
      "description": "Logs de auditoria do sistema"
    }
  }
}
