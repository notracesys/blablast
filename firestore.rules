rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se o usuário logado é um administrador
    // Ela busca o documento do usuário no banco e checa o campo isAdmin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para a coleção de usuários
    match /users/{userId} {
      // O próprio usuário ou um admin podem ler os dados individuais
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // APENAS administradores podem listar TODOS os usuários de uma vez
      allow list: if request.auth != null && isAdmin();
      
      // Criação permitida apenas para o dono da conta
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Atualização permitida para o dono da conta (saldo) ou admins
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Regras para as configurações globais (dificuldade e faturamento)
    match /settings/game {
      // Leitura pública (necessário para o jogo carregar a dificuldade)
      allow read: if true;
      // Escrita permitida APENAS para administradores
      allow write: if request.auth != null && isAdmin();
    }
  }
}