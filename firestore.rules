
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário logado é admin consultando o banco
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      // Permite ler o próprio perfil ou se for admin ler qualquer um
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Permite listar a coleção inteira de usuários APENAS para admins
      allow list: if request.auth != null && isAdmin();
      
      // Criação de perfil no registro
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Atualização do próprio perfil ou por admin
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Deleção proibida por segurança
      allow delete: if false;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if request.auth != null && isAdmin();
      allow create: if request.auth != null;
    }

    match /influencers/{influencerId} {
      allow read, list, write: if request.auth != null && isAdmin();
    }

    match /logs/{logId} {
      allow read, list: if request.auth != null && isAdmin();
      allow create: if request.auth != null;
    }
  }
}
