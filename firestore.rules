
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // HELPERS DE SEGURANÇA
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // O OWNER é o Deus do sistema: Claim Admin ou Campo no Banco
    function isOwner() {
      return isAuth() && (
        request.auth.token.role == 'owner' || 
        getUserData().role == 'owner' || 
        getUserData().isAdmin == true
      );
    }
    
    // MANAGER: Claim ou Campo
    function isManager() {
      return isAuth() && (
        request.auth.token.role == 'manager' || 
        getUserData().role == 'manager'
      );
    }

    // REGRAS POR COLEÇÃO
    
    match /users/{userId} {
      allow get: if isAuth() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create: if isAuth();
      // Apenas Owner muda campos sensíveis
      allow update: if isOwner() || (
        isAuth() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isAdmin', 'managerId', 'balance', 'commissionBalance'])
      );
    }
    
    match /managers/{uid} {
      allow read: if isOwner() || (isManager() && request.auth.uid == uid);
      allow write: if isOwner();
    }
    
    match /influencers/{uid} {
      allow read: if isOwner() || (isManager() && resource.data.managerId == request.auth.uid);
      allow list: if isOwner() || isManager();
      allow write: if isOwner() || isManager();
    }
    
    match /settings/game {
      allow read: if isAuth();
      allow write: if isOwner();
    }
    
    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow create: if isAuth(); // Permite que o sistema registre ações
    }

    match /matches/{matchId} {
      allow read: if isOwner() || (isManager() && resource.data.managerId == request.auth.uid) || (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
    }

    // BLOQUEIO GLOBAL PARA DESLOGADOS
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
