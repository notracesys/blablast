
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // MODO DEUS ATIVADO: 
    // Qualquer usuário autenticado tem permissão TOTAL de leitura e escrita.
    // Isso elimina bloqueios de segurança enquanto você gerencia o sistema.
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
