rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MODO DEUS: Permissão total para qualquer usuário autenticado.
    // Isso garante que você nunca seja bloqueado enquanto estiver logado.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}