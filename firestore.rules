rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Função auxiliar para verificar se o usuário logado é um administrador
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para a coleção de usuários
    match /users/{userId} {
      // O próprio usuário ou um admin podem ler dados individuais
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // APENAS administradores podem listar a coleção inteira
      allow list: if request.auth != null && isAdmin();
      
      // Criação permitida apenas para o dono da conta
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // Atualização permitida para o dono da conta ou admins
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Regras para as configurações globais
    match /settings/game {
      // Leitura pública para o jogo funcionar
      allow read: if true;
      // Escrita apenas para administradores
      allow write: if request.auth != null && isAdmin();
    }
  }
}