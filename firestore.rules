rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // HELPERS DE IDENTIDADE (MODO DEUS)
    function isAuth() {
      return request.auth != null;
    }
    
    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }
    
    function hasUserDoc() {
      return isAuth() && exists(userPath());
    }

    // Verifica se o usuário é OWNER (Dono Absoluto)
    // Checa primeiro o Token (Performance) e depois o Documento (Bootstrapping/Fallback)
    function isOwner() {
      return isAuth() && (
        request.auth.token.role == 'owner' || 
        request.auth.token.isAdmin == true ||
        (exists(userPath()) && (
          get(userPath()).data.role == 'owner' || 
          get(userPath()).data.isAdmin == true
        ))
      );
    }
    
    // Verifica se o usuário é MANAGER (Gerente)
    function isManager() {
      return isAuth() && (
        request.auth.token.role == 'manager' ||
        (exists(userPath()) && get(userPath()).data.role == 'manager')
      );
    }

    // REGRAS POR COLEÇÃO
    
    match /users/{userId} {
      // Usuário vê a si mesmo, Owner vê todos, Manager vê sua rede (listagem filtrada no front)
      allow get: if isAuth() && (request.auth.uid == userId || isOwner() || isManager());
      allow list: if isOwner() || isManager();
      
      allow create: if isAuth();
      
      // Update: Owner faz tudo. User só edita campos permitidos.
      // Impede que o usuário mude seu próprio cargo ou saldo.
      allow update: if isOwner() || (
        isAuth() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isAdmin', 'balance', 'commissionBalance', 'managerCommissionRate', 'permissions'])
      );
    }
    
    match /influencers/{influencerId} {
      // Owner vê tudo. Manager vê somente o que é dele.
      allow read: if isOwner() || (isManager() && resource.data.managerId == request.auth.uid);
      allow write: if isOwner() || isManager();
    }
    
    match /settings/{settingId} {
      allow read: if isAuth();
      allow write: if isOwner();
    }
    
    match /logs/{logId} {
      allow read: if isOwner();
      allow write: if isAuth(); 
    }

    // BLOQUEIO GLOBAL (Tudo que não foi definido acima exige ser Owner)
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}