rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funções auxiliares simplificadas para máxima performance
    function isAuth() {
      return request.auth != null;
    }

    // MODO DEUS: Permite acesso total a usuários logados nas coleções principais.
    // Isso evita erros de permissão causados por latência de consulta em regras complexas.
    
    match /users/{userId} {
      allow read, write: if isAuth();
    }

    match /settings/{document=**} {
      allow read, write: if isAuth();
    }

    match /influencers/{id} {
      allow read, write: if isAuth();
    }
    
    match /logs/{id} {
      allow read, write: if isAuth();
    }

    // Proteção para outras coleções futuras
    match /{document=**} {
      allow read, write: if isAuth();
    }
  }
}