
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // MODO DEUS ATIVADO: 
    // Se o usuário está autenticado (logado), ele tem poder total de leitura e escrita.
    // Isso garante que você nunca mais receba "Missing or insufficient permissions".
    
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
