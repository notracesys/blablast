
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para verificar se o usuário é Admin (UID deve ter isAdmin: true no documento)
    function isAdmin() {
      return request.auth != null && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{userId} {
      // Regras de leitura: próprio ou admin
      allow get: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      // Listagem geral: Bloqueada para evitar peso de leads (Apenas Master se necessário)
      allow list: if request.auth != null && isAdmin();
      
      // Criação/Update
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      
      allow delete: if false;
    }

    match /settings/{docId} {
      // Configurações globais: Leitura pública para o motor do jogo funcionar, escrita só Admin
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /matches/{matchId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow create: if request.auth != null;
    }

    match /influencers/{influencerId} {
      allow read, list, write: if isAdmin();
    }

    match /logs/{logId} {
      // Logs de auditoria: Leitura exclusiva admin, criação permitida para registro de ações
      allow read, list: if isAdmin();
      allow create: if request.auth != null;
    }
  }
}
