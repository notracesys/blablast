
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // HELPERS BÁSICOS
    function isAuth() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // O OWNER É DEUS
    function isOwner() {
      return isAuth() && (
        request.auth.token.role == 'owner' || 
        getUserData().role == 'owner' || 
        getUserData().isAdmin == true
      );
    }
    
    // MANAGER (Acesso restrito)
    function isManager() {
      return isAuth() && (
        request.auth.token.role == 'manager' || 
        getUserData().role == 'manager'
      );
    }

    // REGRAS POR COLEÇÃO
    
    match /users/{userId} {
      allow get: if isAuth() && (request.auth.uid == userId || isOwner());
      allow list: if isOwner();
      allow create: if isAuth();
      allow update: if isOwner() || (
        isAuth() && request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['role', 'isAdmin', 'managerId', 'balance', 'commissionBalance'])
      );
    }
    
    match /settings/{docId} {
      allow read: if isAuth();
      allow write: if isOwner();
    }
    
    match /influencers/{influencerId} {
      allow read: if isOwner() || (isManager() && resource.data.managerId == request.auth.uid);
      allow list: if isOwner() || isManager();
      allow write: if isOwner() || isManager();
    }
    
    match /logs/{logId} {
      allow read: if isOwner();
      allow create: if isAuth();
    }

    match /auditLogs/{logId} {
      allow read: if isOwner();
      allow create: if isAuth();
    }

    match /matches/{matchId} {
      allow read: if isOwner() || (isAuth() && resource.data.userId == request.auth.uid);
      allow list: if isOwner() || isManager();
      allow create: if isAuth();
    }

    // BLOQUEIO GLOBAL PARA SEGURANÇA
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
